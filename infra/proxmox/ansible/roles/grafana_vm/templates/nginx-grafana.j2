# {{ ansible_managed }}
server {
    listen {{ vm_vpn_ip | default('0.0.0.0') }}:80;
    server_name {{ grafana_domain }};
    return 301 https://{{ grafana_domain }}$request_uri;
}

server {
    listen {{ vm_vpn_ip | default('0.0.0.0') }}:443 ssl;
    server_name {{ grafana_domain }} {{ vm_vpn_ip | default('') }};

    ssl_certificate     /etc/nginx/certs/grafana.crt;
    ssl_certificate_key /etc/nginx/certs/grafana.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Grafana Live (websocket)
    location /api/live/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }
}
