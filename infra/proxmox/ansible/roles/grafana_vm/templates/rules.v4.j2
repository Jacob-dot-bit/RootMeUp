# {{ ansible_managed }}
# Les chaînes ts-* sont ajoutées par tailscaled à son démarrage.
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -i lo -j ACCEPT
-A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A INPUT -i tailscale0 -p tcp -m tcp --dport 22 -j ACCEPT
-A INPUT -i tailscale0 -p tcp -m tcp --dport 3000 -j ACCEPT
-A INPUT -i tailscale0 -p tcp -m tcp --dport 9090 -j ACCEPT
-A INPUT -p udp -m udp --dport 41641 -j ACCEPT
-A INPUT -p icmp -j ACCEPT
COMMIT
