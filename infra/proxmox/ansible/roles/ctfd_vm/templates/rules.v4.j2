# {{ ansible_managed }}
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -i lo -j ACCEPT
-A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A INPUT -p udp -m udp --dport 41641 -j ACCEPT
-A INPUT -i tailscale0 -p icmp -j ACCEPT
-A INPUT -i tailscale0 -p tcp -m tcp --dport 22 -j ACCEPT
-A INPUT -i tailscale0 -p tcp -m tcp --dport 443 -j ACCEPT
-A INPUT -i tailscale0 -p tcp -m tcp --dport 80 -j ACCEPT
# Ports dynamiques des instances de challenges (plugin containers)
-A INPUT -i tailscale0 -p tcp -m tcp --dport 32768:60999 -j ACCEPT
-A INPUT -s {{ grafana_tailnet_ip }}/32 -i tailscale0 -p tcp -m tcp --dport 9100 -j ACCEPT
-A INPUT -s {{ grafana_tailnet_ip }}/32 -i tailscale0 -p tcp -m tcp --dport 8080 -j ACCEPT
-A FORWARD -o docker0 -j ACCEPT
-A FORWARD -i docker0 -j ACCEPT
COMMIT
