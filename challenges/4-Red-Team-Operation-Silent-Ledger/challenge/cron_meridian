SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Meridian nightly cleanup - runs every minute in this lab environment
# (would be a nightly job in production) so the CTF instance stays snappy.
#
# DESIGN NOTE (CTF): the job runs as r.dubois (NOT root). The script it runs is
# group-writable by svc_backup, so svc_backup can inject a command that executes
# with r.dubois' privileges -- a *lateral* move (svc_backup -> r.dubois), never
# a jump to root. This keeps the escalation chain monotonic.
* * * * * r.dubois /opt/scripts/cleanup.sh
